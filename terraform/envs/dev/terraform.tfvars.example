aws_region          = "ap-south-1"
environment         = "dev"
project_name        = "microservice-cicd-kubernetes"
github_repo         = "AswinArun321/microservice-cicd-kubernetes"
vpc_cidr            = "10.20.0.0/16"
public_subnet_cidrs = ["10.20.1.0/24", "10.20.2.0/24"]
availability_zones  = ["ap-south-1a", "ap-south-1b"]
enable_nat          = false # Demo mode (set true for production with private subnets)
cluster_version     = "1.31"
node_instance_types = ["t3.medium"]
desired_node_count  = 2
public_access_cidrs = ["0.0.0.0/0"] # In production, restrict to your public IP/32
create_oidc_provider = true

